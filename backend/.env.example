# ==========================================
# PiSentinel Security Hub - Configuration
# ==========================================

# Secret key used for signing JWT tokens (Change this in production!)
SECRET_KEY=pisentinel_super_secret_jwt_key_rpi_2026_change_in_production!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google OAuth 2.0 ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized JavaScript origins: http://localhost:8000, http://<YOUR_RASPBERRY_IP>:8000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Whitelist of Google Accounts allowed to log in (comma-separated)
ALLOWED_EMAILS=your.email@gmail.com,admin@example.com

# --- Local Admin Fallback ---
# Emergency credentials if Google OAuth is offline or not configured yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=RaspberrySec2026!

# --- System & Security Config ---
# Environment: production or development
ENVIRONMENT=development
# Simulation mode: 'auto' (detects if Linux / root), 'true' (force simulation), 'false' (strict Linux system logs only)
SIMULATION_MODE=auto

# Host, Port and Reverse Proxy Subpath
# (Le port 80 reste 100% libre et réservé à votre site actuel !)
HOST=127.0.0.1
PORT=8443
# Si accédé via https://mon-domaine.com/sentinel, mettez ROOT_PATH=/sentinel
ROOT_PATH=/sentinel
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,http://127.0.0.1:8443
