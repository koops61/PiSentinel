[Unit]
Description=PiSentinel - Raspberry Pi Security Hub & SOC
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pisentinel/backend
ExecStart=/opt/pisentinel/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=/opt/pisentinel/backend/.env

# Security Sandbox
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
