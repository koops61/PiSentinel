[Unit]
Description=PiSentinel - Raspberry Pi Security Hub & SOC
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/var/www/html/sentinel/backend
Environment=PYTHONPATH=/var/www/html/sentinel/backend
EnvironmentFile=/var/www/html/sentinel/backend/.env
ExecStart=/var/www/html/sentinel/.venv/bin/python -m app.main
Restart=always
RestartSec=5

# Security Sandbox
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
